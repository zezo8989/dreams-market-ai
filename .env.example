# Database Configuration
DATABASE_URL=postgresql://postgres:dreammarket_admin@postgres:5432/dreams_market
DATABASE_ECHO=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=10

# CORS
CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://localhost:3000"]

# Application
APP_NAME=Dreams Market AI Settlement Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,xlsx,xls,csv

# Reconciliation Engine
RECONCILIATION_TOLERANCE_PERCENT=0.1
RECONCILIATION_DATE_TOLERANCE_DAYS=3

# Anomaly Detection
ANOMALY_Z_SCORE_THRESHOLD=-2
ANOMALY_MOVING_AVERAGE_DAYS=14

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@dreammarket.com
SMTP_FROM_NAME=Dreams Market Platform

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Redis (optional, for caching/rate limiting)
REDIS_URL=redis://redis:6379/0

# Bank Configuration
SUPPORTED_BANKS=["banque_misr", "nbe", "aaib"]

# Export Configuration
EXPORT_PDF_MARGIN=20
EXPORT_EXCEL_MAX_ROWS=100000
